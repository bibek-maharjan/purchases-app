    F --> G["Form: name, rate, qty 1, seller"]
    G --> H["Date: Today / Yesterday / Custom BS"]
    H --> I["Save on phone (BS + AD date)"]
    I --> J["Menu: Export zip backup"]
    J --> K["Keep zip in storage or Drive"]
